# =================================================================
# TELEGRAM LECTURE FORWARDER BOT - ENVIRONMENT CONFIGURATION
# =================================================================

# 1. TELEGRAM API CREDENTIALS (from https://my.telegram.org)
API_ID=12345678
API_HASH=your_telegram_api_hash_here

# 2. BOT TOKENS (from @BotFather)
# Main visible bot that users interact with and /start in DM
MAIN_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Hidden worker bot tokens for multi-token round robin throughput (comma-separated)
# Leave empty for single bot mode: WORKER_BOT_TOKENS=
# Or add when scaling to 1000+ users: WORKER_BOT_TOKENS=1111:token2,2222:token3
WORKER_BOT_TOKENS=

# 3. STORAGE & CHAT IDENTIFIERS
# Master Forum Supergroup ID where your lecture topics are stored
# Note: Usually starts with -100 (e.g. -1001234567890)
FORUM_CHAT_ID=-1001234567890

# Private Backup Channel ID where user data snapshots are backed up for disaster recovery
BACKUP_CHANNEL_ID=-1009876543210

# 4. SERVER & NETWORK CONFIGURATION
HOST=0.0.0.0
PORT=8080

# Public URL of the frontend Telegram Mini App (used for WebApp buttons and CORS)
WEBAPP_URL=https://your-frontend-app.onrender.com

# 5. FORCE SUBSCRIBE CHANNEL (FSUB) - OPTIONAL
# Leave empty to disable. Add your channel @username or ID to require users to join before accessing lectures.
# Ensure the bot is added as an Admin in this channel!
FORCE_SUB_CHANNEL=@YourUpdatesChannel
FORCE_SUB_INVITE_LINK=https://t.me/YourUpdatesChannel

# 6. ADMIN IDENTIFIER (Get your Telegram User ID by sending /id to @userinfobot)
# Grants exclusive access to /admin, /broadcast, and /rescan
ADMIN_ID=123456789


